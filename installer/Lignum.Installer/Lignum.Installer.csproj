<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the Lignum installer (ticket 07) with FalkForge. Not in Lignum.sln: it needs the published exe.
       Run: dotnet run -c Release (after the publish command in CLAUDE.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="License.rtf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FalkForge" Version="0.5.0-beta.8" />
  </ItemGroup>

</Project>
