<Project Sdk="Microsoft.NET.Sdk">

  <!-- Manual-only performance benchmarks (ticket 19). A console app, not a test project, so
       `dotnet test` never runs it. See CLAUDE.md for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lignum.Benchmarks.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lignum.Core\Lignum.Core.csproj" />
  </ItemGroup>

</Project>
