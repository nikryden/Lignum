<!-- Dark theme brushes. Every key here must also exist in Light.xaml (see ThemeKeys.cs). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="#E6E6E6" />

    <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="ViewerForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="LineNumberBackgroundBrush" Color="#252526" />
    <SolidColorBrush x:Key="LineNumberForegroundBrush" Color="#858585" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#264F78" />
    <SolidColorBrush x:Key="SearchMatchBackgroundBrush" Color="#7A6400" />

    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PaneBorderBrush" Color="#3C3C3C" />

    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#FF8A80" />

    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#4A3F14" />
    <SolidColorBrush x:Key="BannerBorderBrush" Color="#7A6A2A" />
    <SolidColorBrush x:Key="BannerForegroundBrush" Color="#F5E7B0" />

    <!-- Filter rule chips (ticket 12): include green, exclude red. -->
    <SolidColorBrush x:Key="FilterIncludeBackgroundBrush" Color="#1E3A1E" />
    <SolidColorBrush x:Key="FilterIncludeBorderBrush" Color="#5FAF55" />
    <SolidColorBrush x:Key="FilterExcludeBackgroundBrush" Color="#45201E" />
    <SolidColorBrush x:Key="FilterExcludeBorderBrush" Color="#D0605A" />
</ResourceDictionary>
