<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Lignum</AssemblyName>
    <RootNamespace>Lignum.App</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Bundle WPF's native DLLs into the single-file exe instead of placing them beside it. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Placeholder icon (ticket 03): tree rings, "lignum" being Latin for wood. -->
    <ApplicationIcon>Assets\Lignum.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Lignum.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skills shipped with Lignum (the "/" list shows them as built-in); named BuiltInSkills/<name>. -->
    <EmbeddedResource Include="Assistant\BuiltInSkills\*\SKILL.md" LogicalName="BuiltInSkills/%(RecursiveDir)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lignum.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects drop System.IO from the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lignum.Core\Lignum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
