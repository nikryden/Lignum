<Window x:Class="Lignum.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lignum.App"
        xmlns:views="clr-namespace:Lignum.App.Views"
        xmlns:settings="clr-namespace:Lignum.App.Settings"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:core="clr-namespace:Lignum.Core;assembly=Lignum.Core"
        Title="{Binding Title}" Icon="/Assets/Lignum.ico" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        AllowDrop="True" PreviewDragOver="OnPreviewDragOver" Drop="OnDrop"
        PreviewMouseWheel="OnPreviewMouseWheel">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:EqualityConverter x:Key="IsEqual" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <!-- Find (ticket 10) acts on the selected tab. -->
        <KeyBinding Gesture="Ctrl+F" Command="{Binding SelectedTab.Search.OpenFindBarCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding AllTabsSearch.OpenCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding Assistant.TogglePanelCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding OpenInEditorCommand}" />
        <KeyBinding Gesture="F3" Command="{Binding SelectedTab.Search.FindNextCommand}" />
        <KeyBinding Gesture="Shift+F3" Command="{Binding SelectedTab.Search.FindPreviousCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding Appearance.ZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding Appearance.ZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding Appearance.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding Appearance.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding Appearance.ResetZoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding Appearance.ResetZoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
        <!-- Navigation (ticket 05). LogTabView repeats Ctrl+Home/End on the LogView because its ScrollViewer would eat them. -->
        <KeyBinding Gesture="Ctrl+G" Command="{x:Static local:MainWindow.GoToLineCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{x:Static local:MainWindow.OpenFolderCommand}" />
        <KeyBinding Gesture="Ctrl+Home" Command="{Binding SelectedTab.Navigation.GoToStartCommand}" />
        <KeyBinding Gesture="Ctrl+End" Command="{Binding SelectedTab.Navigation.GoToEndCommand}" />
        <!-- Bookmarks (ticket 17). -->
        <KeyBinding Gesture="Ctrl+F2" Command="{Binding SelectedTab.ToggleBookmarkCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding SelectedTab.NextBookmarkCommand}" />
        <KeyBinding Gesture="Shift+F2" Command="{Binding SelectedTab.PreviousBookmarkCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <!-- ApplicationCommands.Open carries the Ctrl+O gesture. -->
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenExecuted" />
        <CommandBinding Command="{x:Static local:MainWindow.GoToLineCommand}" Executed="OnGoToLineExecuted" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFolderCommand}" Executed="OnOpenFolderExecuted" />
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _folder…" Command="{x:Static local:MainWindow.OpenFolderCommand}" InputGestureText="Ctrl+Shift+O" />
                <MenuItem Header="Open _recent" ItemsSource="{Binding RecentFiles}"
                          IsEnabled="{Binding HasRecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="_Export with notes…" Click="OnExportClick" />
                <MenuItem Header="Export with notes, _uncompressed (huge logs)…" Click="OnExportUncompressedClick" />
                <MenuItem Header="Open in e_ditor" Command="{Binding OpenInEditorCommand}" InputGestureText="Ctrl+Shift+E" />
                <MenuItem Header="Copy full _path" Command="{Binding SelectedTab.CopyFullPathCommand}" />
                <MenuItem Header="Open containing _folder" Command="{Binding SelectedTab.OpenContainingFolderCommand}" />
                <MenuItem Header="_Close tab" Command="{Binding CloseTabCommand}" InputGestureText="Ctrl+W" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" Command="{Binding SelectedTab.CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="Select _all" Command="{Binding SelectedTab.SelectAllCommand}" InputGestureText="Ctrl+A" />
                <MenuItem Header="Copy to _search" Command="{Binding SelectedTab.CopyToSearchCommand}" InputGestureText="Ctrl+Shift+C" />
            </MenuItem>
            <MenuItem Header="_Go">
                <MenuItem Header="_Line…" Command="{x:Static local:MainWindow.GoToLineCommand}" InputGestureText="Ctrl+G" />
                <MenuItem Header="_Start of file" Command="{Binding SelectedTab.Navigation.GoToStartCommand}" InputGestureText="Ctrl+Home" />
                <MenuItem Header="_End of file" Command="{Binding SelectedTab.Navigation.GoToEndCommand}" InputGestureText="Ctrl+End" />
                <Separator />
                <MenuItem Header="Toggle _bookmark" Command="{Binding SelectedTab.ToggleBookmarkCommand}" InputGestureText="Ctrl+F2" />
                <MenuItem Header="_Next bookmark" Command="{Binding SelectedTab.NextBookmarkCommand}" InputGestureText="F2" />
                <MenuItem Header="_Previous bookmark" Command="{Binding SelectedTab.PreviousBookmarkCommand}" InputGestureText="Shift+F2" />
                <MenuItem Header="C_lear all bookmarks" Command="{Binding SelectedTab.ClearBookmarksCommand}" />
                <!-- Ticket 24; the items are the selected tab's color toggles (shared with its bookmarks pane). -->
                <MenuItem Header="Remove bookmarks _without notes" Command="{Binding SelectedTab.RemoveBookmarksWithoutNotesCommand}" />
                <MenuItem Header="Re_move bookmarks of color" ItemsSource="{Binding SelectedTab.BookmarkFilter.ColorToggles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Color}" />
                            <Setter Property="Command" Value="{Binding DataContext.SelectedTab.RemoveBookmarksOfColorCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding Color}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Show onl_y colors" ItemsSource="{Binding SelectedTab.BookmarkFilter.ColorToggles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Color}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsShown}" />
                            <Setter Property="StaysOpenOnClick" Value="True" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Bookmarks _pane" IsCheckable="True"
                          IsChecked="{Binding SelectedTab.IsBookmarksPaneOpen, Mode=TwoWay, FallbackValue=False}" />
            </MenuItem>
            <MenuItem Header="_Search">
                <MenuItem Header="_Find…" Command="{Binding SelectedTab.Search.OpenFindBarCommand}" InputGestureText="Ctrl+F" />
                <MenuItem Header="Find in _all tabs…" Command="{Binding AllTabsSearch.OpenCommand}" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="Find in f_iles…" Command="{Binding AllTabsSearch.OpenFindInFilesCommand}" />
                <MenuItem Header="Find _next" Command="{Binding SelectedTab.Search.FindNextCommand}" InputGestureText="F3" />
                <MenuItem Header="Find _previous" Command="{Binding SelectedTab.Search.FindPreviousCommand}" InputGestureText="Shift+F3" />
                <MenuItem Header="Fi_lter rules" IsCheckable="True"
                          IsChecked="{Binding SelectedTab.Search.IsFilterBarOpen, Mode=TwoWay, FallbackValue=False}" />
                <MenuItem Header="Search _inside filter" IsCheckable="True"
                          IsChecked="{Binding SelectedTab.Search.SearchInsideFilter, Mode=TwoWay, FallbackValue=True}" />
                <MenuItem Header="_Hide non-matching lines" IsCheckable="True"
                          IsChecked="{Binding SelectedTab.HideNonMatchingLines, Mode=TwoWay, FallbackValue=False}" />
                <MenuItem Header="Highlight matches _outside the filter" IsCheckable="True"
                          IsChecked="{Binding HighlightMatchesOutsideFilter, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="_Results pane" IsCheckable="True"
                          IsChecked="{Binding SelectedTab.Search.IsResultsPaneOpen, Mode=TwoWay, FallbackValue=False}" />
            </MenuItem>
            <!-- Appearance (ticket 13). DataContext is the AppearanceViewModel. -->
            <MenuItem Header="_View" DataContext="{Binding Appearance, RelativeSource={RelativeSource AncestorType=Window}}">
                <MenuItem Header="_Theme">
                    <MenuItem Header="Use _Windows setting" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static settings:ThemeChoice.System}"
                              IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=System}" />
                    <MenuItem Header="_Light" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static settings:ThemeChoice.Light}"
                              IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=Light}" />
                    <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}"
                              CommandParameter="{x:Static settings:ThemeChoice.Dark}"
                              IsChecked="{Binding ThemeChoice, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=Dark}" />
                </MenuItem>
                <MenuItem Header="_Font…" Click="OnFontClick" />
                <MenuItem Header="_Highlight rules…" Click="OnHighlightRulesClick" />
                <MenuItem Header="_Syntax schemes…" Click="OnSyntaxSchemesClick" />
                <MenuItem Header="_External editor…" Click="OnExternalEditorClick" />
                <MenuItem Header="AI _permissions…" Click="OnAiPermissionsClick" />
                <MenuItem Header="Tab _width">
                    <MenuItem Header="_2" Command="{Binding SetTabWidthCommand}"
                              IsChecked="{Binding TabWidth, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=2}">
                        <MenuItem.CommandParameter><sys:Int32>2</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="_4" Command="{Binding SetTabWidthCommand}"
                              IsChecked="{Binding TabWidth, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=4}">
                        <MenuItem.CommandParameter><sys:Int32>4</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="_8" Command="{Binding SetTabWidthCommand}"
                              IsChecked="{Binding TabWidth, Mode=OneWay, Converter={StaticResource IsEqual}, ConverterParameter=8}">
                        <MenuItem.CommandParameter><sys:Int32>8</sys:Int32></MenuItem.CommandParameter>
                    </MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl+Plus / Ctrl+Wheel" />
                <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+Minus" />
                <MenuItem Header="_Reset zoom" Command="{Binding ResetZoomCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <!-- Detail pane (ticket 07); layout is app-wide: MainViewModel.DetailPane. -->
                <MenuItem Header="_Detail pane" IsCheckable="True"
                          IsChecked="{Binding DataContext.DetailPane.IsOpen, RelativeSource={RelativeSource AncestorType=Window}}" />
                <MenuItem Header="Dock detail pane _right" Command="{Binding DataContext.DetailPane.DockRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.DetailPane.Dock, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsEqual}, ConverterParameter=Right}" />
                <MenuItem Header="Dock detail pane _bottom" Command="{Binding DataContext.DetailPane.DockBottomCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          IsChecked="{Binding DataContext.DetailPane.Dock, Mode=OneWay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsEqual}, ConverterParameter=Bottom}" />
                <MenuItem Header="Show _full line" Command="{Binding DataContext.ShowFullLineCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Separator />
                <MenuItem Header="_AI access" IsCheckable="True" InputGestureText="Ctrl+Shift+A"
                          IsChecked="{Binding DataContext.Assistant.IsPanelOpen, RelativeSource={RelativeSource AncestorType=Window}}" />
            </MenuItem>
        </Menu>
        <!-- Quick icon bar: open and close the panes (lit = open). -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="{DynamicResource WindowBackgroundBrush}">
            <ToolBar Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource WindowForegroundBrush}"
                     TextElement.FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextElement.FontSize="15">
                <Button Content="&#xE721;" ToolTip="Find (Ctrl+F)" Command="{Binding SelectedTab.Search.OpenFindBarCommand}" />
                <ToggleButton Content="&#xE71C;" ToolTip="Filter rules"
                              IsChecked="{Binding SelectedTab.Search.IsFilterBarOpen, Mode=TwoWay, FallbackValue=False}" />
                <Button Content="&#xE71D;" ToolTip="Find in all tabs (Ctrl+Shift+F)" Command="{Binding AllTabsSearch.OpenCommand}" />
                <Separator />
                <ToggleButton Content="&#xE8FD;" ToolTip="Results pane"
                              IsChecked="{Binding SelectedTab.Search.IsResultsPaneOpen, Mode=TwoWay, FallbackValue=False}" />
                <ToggleButton Content="&#xE734;" ToolTip="Bookmarks pane"
                              IsChecked="{Binding SelectedTab.IsBookmarksPaneOpen, Mode=TwoWay, FallbackValue=False}" />
                <ToggleButton Content="&#xE7C3;" ToolTip="Detail pane (full line)" IsChecked="{Binding DetailPane.IsOpen, Mode=TwoWay}" />
                <ToggleButton Content="&#xE8F1;" ToolTip="Find in all tabs / find in files results"
                              IsChecked="{Binding AllTabsSearch.IsPaneOpen, Mode=TwoWay}" />
                <ToggleButton Content="&#xE8F2;" ToolTip="AI access (Ctrl+Shift+A)" IsChecked="{Binding AssistantPane.IsOpen, Mode=TwoWay}" />
            </ToolBar>
        </ToolBarTray>
        <!-- Tab strip only: the tab contents live in the ItemsControl below so each tab keeps its own view (ticket 28: shared with floating windows). -->
        <views:TabStrip DockPanel.Dock="Top" DataContext="{Binding MainGroup}" />
        <views:TabStatusBar DockPanel.Dock="Bottom" DataContext="{Binding MainGroup}" />
        <!-- Find in all tabs (ticket 01): shared across tabs, above the status bar. -->
        <Border DockPanel.Dock="Bottom" Height="260" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PaneBorderBrush}"
                Visibility="{Binding AllTabsSearch.IsResultsListVisible, Converter={StaticResource BoolToVisibility}}">
            <views:AllTabsSearchPane DataContext="{Binding AllTabsSearch}" ShowControls="False" />
        </Border>
        <!-- The tabs, with the AI panel (ticket 05) docked right or at the bottom; drag the splitter to resize it. -->
        <views:DetailPaneLayout Dock="{Binding AssistantPane.Dock}" IsPaneOpen="{Binding AssistantPane.IsOpen}"
                                PaneWidth="{Binding AssistantPane.PaneWidth}" PaneHeight="{Binding AssistantPane.PaneHeight}">
            <views:DetailPaneLayout.Pane>
                <views:AssistantPanel DataContext="{Binding Assistant}" />
            </views:DetailPaneLayout.Pane>
            <views:DetailPaneLayout.Main>
        <!-- One LogTabView per tab in this window, all kept alive; only the shown one is visible. -->
        <ItemsControl ItemsSource="{Binding MainGroup.Tabs}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:LogTabView Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
            </views:DetailPaneLayout.Main>
        </views:DetailPaneLayout>
    </DockPanel>
</Window>
