<!-- "Highlight line…" (ticket 14): a text color and a background color for the selected lines. Empty = none. -->
<Window x:Class="Lignum.App.Views.LineHighlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lignum.App.Views"
        Title="Highlight line" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Margin="0,0,0,8" />
        <TextBlock Text="Text color (#RRGGBB or pick one, empty for none)" Margin="0,0,0,4" />
        <views:ColorField x:Name="ForegroundField" Margin="0,0,0,12" TextBoxBase.TextChanged="OnColorChanged" />
        <TextBlock Text="Background color (#RRGGBB or pick one, empty for none)" Margin="0,0,0,4" />
        <views:ColorField x:Name="BackgroundField" Margin="0,0,0,12" TextBoxBase.TextChanged="OnColorChanged" />
        <Border BorderThickness="1" BorderBrush="{DynamicResource PaneBorderBrush}" Margin="0,0,0,8">
            <TextBlock x:Name="Sample" Text="2026-01-01 12:00:00 INFO Sample log line" Padding="6,2"
                       FontFamily="Cascadia Mono, Consolas" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
