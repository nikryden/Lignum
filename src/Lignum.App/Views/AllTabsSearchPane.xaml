<!-- Find in all tabs (ticket 01): one search over every open tab, results grouped by file. -->
<UserControl x:Class="Lignum.App.Views.AllTabsSearchPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lignum.App.ViewModels"
             Background="{DynamicResource PaneBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <DockPanel>
        <DockPanel x:Name="ControlsPanel" DockPanel.Dock="Top" Margin="8,4">
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="6,0" Margin="4,0,0,0"
                    Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="Search all tabs" Padding="6,0" Margin="4,0,0,0"
                    Command="{Binding SearchCommand}" />
            <ToggleButton DockPanel.Dock="Right" Content="Per tab" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="Show the results in each tab's own results pane instead of here"
                          IsChecked="{Binding ShowResultsPerTab}" />
            <ToggleButton DockPanel.Dock="Right" Content="NB" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="NonBacktracking regex engine" IsEnabled="{Binding IsRegex}"
                          IsChecked="{Binding UseNonBacktracking}" />
            <ToggleButton DockPanel.Dock="Right" Content=".*" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="Use regular expression" IsChecked="{Binding IsRegex}" />
            <ToggleButton DockPanel.Dock="Right" Content="Aa" Padding="6,1" Margin="8,0,0,0"
                          ToolTip="Match case" IsChecked="{Binding MatchCase}" />
            <TextBlock DockPanel.Dock="Left" Text="Find in all tabs:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FindTextError}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ErrorForegroundBrush}" />
            <TextBox x:Name="FindBox" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4">
            <Button x:Name="CloseListButton" DockPanel.Dock="Right" Content="✕" ToolTip="Close the results"
                    Padding="6,0" Margin="8,0,0,0" Command="{Binding CloseCommand}" />
            <Button DockPanel.Dock="Right" Content="Expand all" Padding="6,0" Margin="4,0,0,0" Command="{Binding ExpandAllCommand}" />
            <Button DockPanel.Dock="Right" Content="Collapse all" Padding="6,0" Command="{Binding CollapseAllCommand}" />
            <TextBlock Text="{Binding Status}" Opacity="0.8" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="ResultList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource WindowForegroundBrush}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseLeftButtonUp="OnResultClick" KeyDown="OnResultKeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:AllTabsFileRow}">
                    <!-- A line between files; click the heading to hide or show its matches. -->
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PaneBorderBrush}"
                            Margin="0,4,0,0" Padding="0,4,0,2" Cursor="Hand" ToolTip="Click to hide or show this file's matches">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Arrow}" Width="16" />
                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AllTabsMatchRow}">
                    <DockPanel Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Left" Width="70" Opacity="0.7" TextAlignment="Right" Margin="0,0,8,0"
                                   Text="{Binding DisplayLine, StringFormat={}{0:N0}}" />
                        <!-- The line, with the matched text highlighted. -->
                        <ItemsControl ItemsSource="{Binding Segments}" Focusable="False"
                                      TextElement.FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="Piece" Text="{Binding Text}" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                            <Setter TargetName="Piece" Property="Background" Value="{DynamicResource SearchMatchBackgroundBrush}" />
                                            <Setter TargetName="Piece" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </DockPanel>
</UserControl>
