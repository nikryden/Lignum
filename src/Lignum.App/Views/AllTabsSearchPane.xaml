<!-- Find in all tabs (ticket 01): one search over every open tab, results grouped by file. -->
<UserControl x:Class="Lignum.App.Views.AllTabsSearchPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lignum.App.ViewModels"
             Background="{DynamicResource PaneBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,4">
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close (Esc)" Padding="6,0" Margin="8,0,0,0"
                    Command="{Binding CloseCommand}" />
            <Button DockPanel.Dock="Right" Content="Cancel" Padding="6,0" Margin="4,0,0,0"
                    Command="{Binding CancelCommand}" />
            <Button DockPanel.Dock="Right" Content="Search all tabs" Padding="6,0" Margin="4,0,0,0"
                    Command="{Binding SearchCommand}" />
            <ToggleButton DockPanel.Dock="Right" Content="Per tab" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="Show the results in each tab's own results pane instead of here"
                          IsChecked="{Binding ShowResultsPerTab}" />
            <ToggleButton DockPanel.Dock="Right" Content="NB" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="NonBacktracking regex engine" IsEnabled="{Binding IsRegex}"
                          IsChecked="{Binding UseNonBacktracking}" />
            <ToggleButton DockPanel.Dock="Right" Content=".*" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="Use regular expression" IsChecked="{Binding IsRegex}" />
            <ToggleButton DockPanel.Dock="Right" Content="Aa" Padding="6,1" Margin="8,0,0,0"
                          ToolTip="Match case" IsChecked="{Binding MatchCase}" />
            <TextBlock DockPanel.Dock="Left" Text="Find in all tabs:" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FindTextError}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ErrorForegroundBrush}" />
            <TextBox x:Name="FindBox" Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" Text="{Binding Status}" Opacity="0.8" />
        <ListBox x:Name="ResultList" ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource WindowForegroundBrush}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseLeftButtonUp="OnResultClick" KeyDown="OnResultKeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type vm:AllTabsFileRow}">
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,6,0,2" />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AllTabsMatchRow}">
                    <DockPanel Margin="12,0,0,0">
                        <TextBlock DockPanel.Dock="Left" Width="70" Opacity="0.7" TextAlignment="Right" Margin="0,0,8,0"
                                   Text="{Binding DisplayLine, StringFormat={}{0:N0}}" />
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                   FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DockPanel>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>
    </DockPanel>
</UserControl>
