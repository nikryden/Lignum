<!-- View → External editor… (ticket 13): which editor File → Open in editor starts, and its argument template. -->
<Window x:Class="Lignum.App.Views.ExternalEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="External editor" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock Text="Preset" Margin="0,0,0,4" />
        <ComboBox x:Name="PresetBox" Margin="0,0,0,12" SelectionChanged="OnPresetChanged" />
        <TextBlock Text="Command (exe name on PATH or full path)" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse…" MinWidth="80" Margin="8,0,0,0" Click="OnBrowseClick" />
            <TextBox x:Name="CommandBox" />
        </DockPanel>
        <TextBlock Text="Arguments ({file} = full path, {line} = 1-based line)" Margin="0,0,0,4" />
        <TextBox x:Name="ArgumentsBox" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
