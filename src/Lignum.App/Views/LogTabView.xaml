<!--
    The content of one tab. DataContext is a LogTabViewModel. One instance exists per open tab (MainWindow
    keeps them all alive and shows only the selected one), so each tab keeps its own viewer, scroll position
    and, later, its own results pane, filters and detail pane: add per-tab panes here, not in MainWindow.
-->
<UserControl x:Class="Lignum.App.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Lignum.App.Viewer"
             xmlns:views="clr-namespace:Lignum.App.Views">
    <UserControl.InputBindings>
        <!-- Selection and copy (ticket 08); a focused text box in the tab handles its own Ctrl+C/Ctrl+A first. -->
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <DockPanel>
        <views:FileChangedBanner DockPanel.Dock="Top" />
        <!-- Main area (find bar, viewer, results pane) plus the detail pane (ticket 07). The detail pane layout is
             app-wide (MainViewModel.DetailPane); the line shown is this tab's (LogTabViewModel.Detail). -->
        <views:DetailPaneLayout
            Dock="{Binding DataContext.DetailPane.Dock, RelativeSource={RelativeSource AncestorType=Window}}"
            IsPaneOpen="{Binding DataContext.DetailPane.IsOpen, RelativeSource={RelativeSource AncestorType=Window}}"
            PaneWidth="{Binding DataContext.DetailPane.PaneWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            PaneHeight="{Binding DataContext.DetailPane.PaneHeight, RelativeSource={RelativeSource AncestorType=Window}}">
            <views:DetailPaneLayout.Main>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="40" />
                        <RowDefinition x:Name="SplitterRow" Height="0" />
                        <RowDefinition x:Name="ResultsRow" Height="0" />
                    </Grid.RowDefinitions>
                    <views:FindBar x:Name="FindBar" Grid.Row="0" DataContext="{Binding Search}" />
                    <views:FilterBar x:Name="FilterBar" Grid.Row="1" DataContext="{Binding Search}" />
                    <!-- LogView is its own IScrollInfo: rows and columns are the scroll units. -->
                    <ScrollViewer Grid.Row="2" CanContentScroll="True" Focusable="False"
                                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                        <viewer:LogView x:Name="LogView" Source="{Binding Lines}" Caret="{Binding Navigation.Caret}"
                                        Selection="{Binding Selection}"
                                        Highlight="{Binding Search.Highlight}"
                                        LineHighlighter="{Binding Highlighting.Highlighter, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:LineHighlighter.None}}"
                                        FullLineRequested="OnFullLineRequested"
                                        FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                        FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        TabWidth="{Binding Appearance.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <!-- Ctrl+Home/End (ticket 05): bound here because the ScrollViewer handles them before the window sees them. -->
                            <viewer:LogView.InputBindings>
                                <KeyBinding Gesture="Ctrl+Home" Command="{Binding Navigation.GoToStartCommand}" />
                                <KeyBinding Gesture="Ctrl+End" Command="{Binding Navigation.GoToEndCommand}" />
                            </viewer:LogView.InputBindings>
                        </viewer:LogView>
                    </ScrollViewer>
                    <!-- Results pane (find all / filter): drag the splitter to resize; ✕ or Search > Results pane collapses it. -->
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource PaneBorderBrush}"
                                  Visibility="{Binding Search.IsResultsPaneOpen, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel Grid.Row="4" Background="{DynamicResource PaneBackgroundBrush}"
                               Visibility="{Binding Search.IsResultsPaneOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="8,2">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Collapse the results pane" Padding="6,0"
                                    Command="{Binding Search.ToggleResultsPaneCommand}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Results:" FontWeight="SemiBold" />
                                <Run Text="{Binding Search.SearchStatus, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                            <!-- Results rows are file lines, so the selection is in file positions too; Ctrl+C copies
                                 only the result lines inside it (ticket 12). A click (handled-too, see code-behind) also
                                 navigates the main view. -->
                            <viewer:LogView x:Name="ResultsView" Source="{Binding Search.Results}"
                                            Highlight="{Binding Search.Highlight}"
                                            Selection="{Binding Search.ResultsSelection}"
                                            LineHighlighter="{Binding Highlighting.Highlighter, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:LineHighlighter.None}}"
                                            FullLineRequested="OnFullLineRequested"
                                            FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                            FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                            TabWidth="{Binding Appearance.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <viewer:LogView.InputBindings>
                                    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyResultsCommand}" />
                                    <KeyBinding Gesture="Ctrl+A" Command="{Binding Search.SelectAllResultsCommand}" />
                                </viewer:LogView.InputBindings>
                            </viewer:LogView>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </views:DetailPaneLayout.Main>
            <views:DetailPaneLayout.Pane>
                <views:DetailPane DataContext="{Binding Detail}" />
            </views:DetailPaneLayout.Pane>
        </views:DetailPaneLayout>
    </DockPanel>
</UserControl>
