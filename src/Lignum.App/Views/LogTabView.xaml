<!--
    The content of one tab. DataContext is a LogTabViewModel. One instance exists per open tab (MainWindow
    keeps them all alive and shows only the selected one), so each tab keeps its own viewer, scroll position
    and, later, its own results pane, filters and detail pane: add per-tab panes here, not in MainWindow.
-->
<UserControl x:Class="Lignum.App.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Lignum.App.Viewer"
             xmlns:views="clr-namespace:Lignum.App.Views">
    <DockPanel>
        <views:FileChangedBanner DockPanel.Dock="Top" />
        <Grid>
            <!-- LogView is its own IScrollInfo: rows and columns are the scroll units. -->
            <ScrollViewer CanContentScroll="True" Focusable="False"
                          VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                <viewer:LogView x:Name="LogView" Source="{Binding Lines}" Caret="{Binding Navigation.Caret}"
                                FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                TabWidth="{Binding Appearance.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                    <!-- Ctrl+Home/End (ticket 05): bound here because the ScrollViewer handles them before the window sees them. -->
                    <viewer:LogView.InputBindings>
                        <KeyBinding Gesture="Ctrl+Home" Command="{Binding Navigation.GoToStartCommand}" />
                        <KeyBinding Gesture="Ctrl+End" Command="{Binding Navigation.GoToEndCommand}" />
                    </viewer:LogView.InputBindings>
                </viewer:LogView>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
