<!--
    The content of one tab. DataContext is a LogTabViewModel. One instance exists per open tab (MainWindow
    keeps them all alive and shows only the selected one), so each tab keeps its own viewer, scroll position
    and, later, its own results pane, filters and detail pane: add per-tab panes here, not in MainWindow.
-->
<UserControl x:Class="Lignum.App.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:Lignum.App.Viewer"
             xmlns:views="clr-namespace:Lignum.App.Views">
    <UserControl.InputBindings>
        <!-- Selection and copy (ticket 08); a focused text box in the tab handles its own Ctrl+C/Ctrl+A first. -->
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <!-- Copy to search (ticket 15): selection, its first line, or the word under the cursor; then find all. -->
        <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyToSearchCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- A bookmark's color dot in the bookmarks pane; DataContext is a BookmarkItem. -->
        <Style x:Key="BookmarkColorDot" TargetType="Ellipse">
            <Setter Property="Fill" Value="{DynamicResource BookmarkMarkerBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Color}" Value="Red">
                    <Setter Property="Fill" Value="{DynamicResource BookmarkMarkerRedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Yellow">
                    <Setter Property="Fill" Value="{DynamicResource BookmarkMarkerYellowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Green">
                    <Setter Property="Fill" Value="{DynamicResource BookmarkMarkerGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Color}" Value="Purple">
                    <Setter Property="Fill" Value="{DynamicResource BookmarkMarkerPurpleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Bulk bookmark actions (ticket 24); the items are the tab's BookmarkFilter.ColorToggles. -->
        <Style x:Key="RemoveColorItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Color}" />
            <Setter Property="Command" Value="{Binding DataContext.RemoveBookmarksOfColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Setter Property="CommandParameter" Value="{Binding Color}" />
        </Style>
        <!-- Hides the other colors' margin markers (not lines); shared with the pane's color filter. -->
        <Style x:Key="ShowColorItem" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Color}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsShown}" />
            <Setter Property="StaysOpenOnClick" Value="True" />
        </Style>
        <!-- Right-click menus (ticket 15). The menu's DataContext is the LogView's (this tab). The text commands take
             the view's selection as parameter (null = the main view's); see LogTabViewModel.ContextMenu.cs.
             "Toggle bookmark" (ticket 17), the note and the color act on the caret line of the view the menu opened on. -->
        <ContextMenu x:Key="MainViewMenu">
            <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
            <MenuItem Header="Copy for _AI" Command="{Binding CopyForAiCommand}"
                      ToolTip="The lines with file name, line numbers and a short prompt, to paste into any AI chat" />
            <MenuItem Header="Copy to _search" Command="{Binding CopyToSearchCommand}" InputGestureText="Ctrl+Shift+C" />
            <Separator />
            <MenuItem Header="Add as _include filter" Command="{Binding AddIncludeFilterCommand}" />
            <MenuItem Header="Add as e_xclude filter" Command="{Binding AddExcludeFilterCommand}" />
            <MenuItem Header="Add as _highlight rule" Command="{Binding AddHighlightRuleCommand}" />
            <Separator />
            <MenuItem Header="Toggle _bookmark" Command="{Binding ToggleBookmarkCommand}" InputGestureText="Ctrl+F2" />
            <MenuItem Header="Edit _description…" Click="OnEditNoteClick" />
            <MenuItem Header="Bookmark co_lor">
                <MenuItem Header="_Blue" Tag="Blue" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Red" Tag="Red" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerRedBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Yellow" Tag="Yellow" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerYellowBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Green" Tag="Green" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerGreenBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Purple" Tag="Purple" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerPurpleBrush}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Clear _all bookmarks" Command="{Binding ClearBookmarksCommand}" />
            <MenuItem Header="Remove bookmarks _without notes" Command="{Binding RemoveBookmarksWithoutNotesCommand}" />
            <MenuItem Header="Re_move bookmarks of color" ItemsSource="{Binding BookmarkFilter.ColorToggles}"
                      ItemContainerStyle="{StaticResource RemoveColorItem}" />
            <MenuItem Header="Show onl_y colors" ItemsSource="{Binding BookmarkFilter.ColorToggles}"
                      ItemContainerStyle="{StaticResource ShowColorItem}" />
            <MenuItem Header="Highlight _line…" Click="OnHighlightLineClick" />
            <MenuItem Header="Remove highligh_t" Click="OnRemoveHighlightClick" />
            <MenuItem Header="Show _full line" Click="OnShowFullLineClick" />
            <MenuItem Header="Open in _editor at this line" Click="OnOpenInEditorClick" />
        </ContextMenu>
        <ContextMenu x:Key="ResultsViewMenu">
            <MenuItem Header="_Copy" Command="{Binding CopyResultsCommand}" InputGestureText="Ctrl+C" />
            <MenuItem Header="Copy for _AI" Command="{Binding CopyForAiCommand}" CommandParameter="{Binding Search.ResultsSelection}"
                      ToolTip="The selected result lines with file name, line numbers and a short prompt" />
            <MenuItem Header="Copy to _search" Command="{Binding CopyToSearchCommand}"
                      CommandParameter="{Binding Search.ResultsSelection}" InputGestureText="Ctrl+Shift+C" />
            <Separator />
            <MenuItem Header="Add as _include filter" Command="{Binding AddIncludeFilterCommand}"
                      CommandParameter="{Binding Search.ResultsSelection}" />
            <MenuItem Header="Add as e_xclude filter" Command="{Binding AddExcludeFilterCommand}"
                      CommandParameter="{Binding Search.ResultsSelection}" />
            <MenuItem Header="Add as _highlight rule" Command="{Binding AddHighlightRuleCommand}"
                      CommandParameter="{Binding Search.ResultsSelection}" />
            <Separator />
            <MenuItem Header="Toggle _bookmark" Command="{Binding ToggleBookmarkCommand}"
                      CommandParameter="{Binding Search.ResultsSelection}" InputGestureText="Ctrl+F2" />
            <MenuItem Header="Edit _description…" Click="OnEditNoteClick" />
            <MenuItem Header="Bookmark co_lor">
                <MenuItem Header="_Blue" Tag="Blue" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Red" Tag="Red" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerRedBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Yellow" Tag="Yellow" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerYellowBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Green" Tag="Green" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerGreenBrush}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Purple" Tag="Purple" Click="OnBookmarkColorClick">
                    <MenuItem.Icon><Ellipse Width="10" Height="10" Fill="{DynamicResource BookmarkMarkerPurpleBrush}" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Show _full line" Click="OnShowFullLineClick" />
        </ContextMenu>
    </UserControl.Resources>
    <DockPanel>
        <views:FileChangedBanner DockPanel.Dock="Top" />
        <!-- Main area (find bar, viewer, results pane) plus the detail pane (ticket 07). The detail pane layout is
             app-wide (MainViewModel.DetailPane); the line shown is this tab's (LogTabViewModel.Detail). -->
        <views:DetailPaneLayout
            Dock="{Binding DataContext.DetailPane.Dock, RelativeSource={RelativeSource AncestorType=Window}}"
            IsPaneOpen="{Binding DataContext.DetailPane.IsOpen, RelativeSource={RelativeSource AncestorType=Window}}"
            PaneWidth="{Binding DataContext.DetailPane.PaneWidth, RelativeSource={RelativeSource AncestorType=Window}}"
            PaneHeight="{Binding DataContext.DetailPane.PaneHeight, RelativeSource={RelativeSource AncestorType=Window}}">
            <views:DetailPaneLayout.Main>
                <DockPanel>
                <!-- The bookmarks pane (ticket 06): every bookmark and note in this file; a click jumps to it. Drag its left
                     edge to resize it (saved, the same for every tab). Smaller text than the rest of the window, so more bookmarks fit. -->
                <Border x:Name="BookmarksPane" DockPanel.Dock="Right" MinWidth="160"
                        Width="{Binding DataContext.BookmarksPaneWidth, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, FallbackValue=260}" BorderThickness="1,0,0,0"
                        TextElement.FontSize="12"
                        Background="{DynamicResource PaneBackgroundBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                        Visibility="{Binding IsBookmarksPaneOpen, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Thumb DockPanel.Dock="Left" Width="4" Cursor="SizeWE" Opacity="0" DragDelta="OnBookmarksPaneResize"
                               ToolTip="Drag to resize the bookmarks pane" />
                        <DockPanel DockPanel.Dock="Top" Margin="6,4">
                            <Button DockPanel.Dock="Right" Content="✕" Padding="5,0" MinHeight="0" MinWidth="0" FontSize="11"
                                    ToolTip="Close the bookmarks pane" Command="{Binding ToggleBookmarksPaneCommand}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding BookmarkFilter.Header}" VerticalAlignment="Center"
                                       ToolTip="Ctrl+F2 or double-click the margin to add one. Right-click a bookmark to edit its description." />
                        </DockPanel>
                        <!-- Sort and filter (ticket 22): view state only, never saved. -->
                        <Grid DockPanel.Dock="Top" Margin="6,0,6,4">
                            <TextBox x:Name="BookmarkSearchBox" MinHeight="0" Padding="4,2" FontSize="12"
                                     ToolTip="Search the descriptions; * matches any text (disk*full)"
                                     Text="{Binding BookmarkFilter.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5"
                                       Text="Search descriptions (* = any)">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=BookmarkSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <WrapPanel DockPanel.Dock="Top" Margin="6,0,6,4">
                            <!-- One dot per color: click to show or hide that color (faded = hidden). -->
                            <ItemsControl ItemsSource="{Binding BookmarkFilter.ColorToggles}" VerticalAlignment="Center"
                                          Margin="0,0,8,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsShown}" Cursor="Hand"
                                                      ToolTip="{Binding Color, StringFormat=Show or hide {0} bookmarks}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9" Margin="0,0,2,0"
                                                            Background="Transparent" BorderThickness="1.5"
                                                            BorderBrush="{DynamicResource WindowForegroundBrush}">
                                                        <Ellipse x:Name="Dot" Width="10" Height="10" Style="{StaticResource BookmarkColorDot}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="Transparent" />
                                                            <Setter TargetName="Dot" Property="Opacity" Value="0.25" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <CheckBox Content="With description" IsChecked="{Binding BookmarkFilter.NotesOnly}" Margin="0,0,8,0"
                                      MinWidth="0" MinHeight="0" FontSize="12" ToolTip="Only bookmarks with a description" />
                            <CheckBox Content="By color" IsChecked="{Binding BookmarkFilter.SortByColor}"
                                      MinWidth="0" MinHeight="0" FontSize="12" ToolTip="Sort by color, then line (otherwise by line)" />
                        </WrapPanel>
                        <ListBox x:Name="BookmarkList" ItemsSource="{Binding BookmarkFilter.Items}" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource WindowForegroundBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Hyperlink.Click="OnNoteLinkClick"
                                 MouseLeftButtonUp="OnBookmarkListClick" KeyDown="OnBookmarkListKeyDown">
                            <ListBox.ContextMenu>
                                <!-- The selected bookmark's links are added below these when it opens (code-behind). -->
                                <ContextMenu Opened="OnBookmarkListMenuOpened">
                                    <MenuItem Header="_Edit description…" Click="OnEditBookmarkDescriptionClick" />
                                    <MenuItem Header="_Copy description" Click="OnCopyBookmarkDescriptionClick" />
                                    <MenuItem Header="_Remove bookmark" Click="OnRemoveBookmarkClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="6,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,4,6,0"
                                                 VerticalAlignment="Top" Style="{StaticResource BookmarkColorDot}" />
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayLine, StringFormat=Line {0:N0}}" />
                                            <TextBlock views:NoteText.Note="{Binding Note}" TextWrapping="Wrap" Opacity="0.85">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="40" />
                        <RowDefinition x:Name="SplitterRow" Height="0" />
                        <RowDefinition x:Name="ResultsRow" Height="0" />
                    </Grid.RowDefinitions>
                    <!-- Rows 0 and 1 held the find and filter bars; they are in the Find window now (MainWindow.FindWindow.cs). -->
                    <!-- LogView is its own IScrollInfo: rows and columns are the scroll units. -->
                    <ScrollViewer Grid.Row="2" CanContentScroll="True" Focusable="False"
                                  VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                        <viewer:LogView x:Name="LogView" Source="{Binding ViewLines}" Caret="{Binding Navigation.Caret}"
                                        Selection="{Binding Selection}"
                                        Bookmarks="{Binding BookmarkFilter.VisibleLines}"
                                        BookmarkNotes="{Binding Bookmarks.Notes}"
                                        BookmarkColors="{Binding Bookmarks.Colors}"
                                        LineHighlights="{Binding Bookmarks.Highlights}"
                                        ContextMenu="{StaticResource MainViewMenu}"
                                        Highlight="{Binding Search.Highlight}"
                                        LineHighlighter="{Binding Highlighting.Highlighter, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:LineHighlighter.None}}"
                                        SyntaxHighlighters="{Binding Syntax.Highlighters, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:SyntaxHighlighterSet.None}}"
                                        FilePath="{Binding Path}"
                                        FullLineRequested="OnFullLineRequested"
                                        MarginDoubleClicked="OnMarginDoubleClicked"
                                        FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                        FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                        TabWidth="{Binding Appearance.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <!-- Ctrl+Home/End (ticket 05): bound here because the ScrollViewer handles them before the window sees them. -->
                            <viewer:LogView.InputBindings>
                                <KeyBinding Gesture="Ctrl+Home" Command="{Binding Navigation.GoToStartCommand}" />
                                <KeyBinding Gesture="Ctrl+End" Command="{Binding Navigation.GoToEndCommand}" />
                            </viewer:LogView.InputBindings>
                        </viewer:LogView>
                    </ScrollViewer>
                    <!-- Results pane (find all / filter): drag the splitter to resize; ✕ or Search > Results pane collapses it. -->
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" Background="{DynamicResource PaneBorderBrush}"
                                  Visibility="{Binding Search.IsResultsPaneOpen, Converter={StaticResource BoolToVisibility}}" />
                    <DockPanel Grid.Row="4" Background="{DynamicResource PaneBackgroundBrush}"
                               Visibility="{Binding Search.IsResultsPaneOpen, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="8,2">
                            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Collapse the results pane" Padding="6,0"
                                    Command="{Binding Search.ToggleResultsPaneCommand}" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Results:" FontWeight="SemiBold" />
                                <Run Text="{Binding Search.ResultsHeader, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <ScrollViewer CanContentScroll="True" Focusable="False"
                                      VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                            <!-- Results rows are file lines, so the selection is in file positions too; Ctrl+C copies
                                 only the result lines inside it (ticket 12). A click (handled-too, see code-behind) also
                                 navigates the main view. -->
                            <viewer:LogView x:Name="ResultsView" Source="{Binding Search.Results}"
                                            Highlight="{Binding Search.Highlight}"
                                            Selection="{Binding Search.ResultsSelection}"
                                            Bookmarks="{Binding BookmarkFilter.VisibleLines}"
                                            BookmarkNotes="{Binding Bookmarks.Notes}"
                                            BookmarkColors="{Binding Bookmarks.Colors}"
                                            LineHighlights="{Binding Bookmarks.Highlights}"
                                            ContextMenu="{StaticResource ResultsViewMenu}"
                                            LineHighlighter="{Binding Highlighting.Highlighter, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:LineHighlighter.None}}"
                                        SyntaxHighlighters="{Binding Syntax.Highlighters, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Static viewer:SyntaxHighlighterSet.None}}"
                                        FilePath="{Binding Path}"
                                            FullLineRequested="OnFullLineRequested"
                                            MarginDoubleClicked="OnMarginDoubleClicked"
                                            FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                            FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                            TabWidth="{Binding Appearance.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                                <viewer:LogView.InputBindings>
                                    <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyResultsCommand}" />
                                    <KeyBinding Gesture="Ctrl+A" Command="{Binding Search.SelectAllResultsCommand}" />
                                    <KeyBinding Gesture="Ctrl+Shift+C" Command="{Binding CopyToSearchCommand}"
                                                CommandParameter="{Binding Search.ResultsSelection}" />
                                    <!-- Bookmarks the result line under the results caret (the window's Ctrl+F2 uses the main view's). -->
                                    <KeyBinding Gesture="Ctrl+F2" Command="{Binding ToggleBookmarkCommand}"
                                                CommandParameter="{Binding Search.ResultsSelection}" />
                                </viewer:LogView.InputBindings>
                            </viewer:LogView>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
                </DockPanel>
            </views:DetailPaneLayout.Main>
            <views:DetailPaneLayout.Pane>
                <views:DetailPane DataContext="{Binding Detail}" />
            </views:DetailPaneLayout.Pane>
        </views:DetailPaneLayout>
    </DockPanel>
</UserControl>
