<!--
    Settings > Syntax schemes (tickets 25, 30): edit the syntax coloring schemes by file type, import and export them.
    DataContext is the app-wide SyntaxViewModel. Changes apply (and are saved) immediately.
-->
<UserControl x:Class="Lignum.App.Views.SyntaxSchemesPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lignum.App.Views">
    <DockPanel Margin="12">
        <!-- Import / export / factory defaults -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Import…" Padding="8,2" Margin="0,0,6,0" Click="OnImportClick"
                        ToolTip="Add schemes from a .json file exported by Lignum" />
                <Button Content="Export…" Padding="8,2" Margin="0,0,6,0" Click="OnExportClick"
                        ToolTip="Save the selected scheme to a .json file" />
                <Button Content="Export all…" Padding="8,2" Margin="0,0,6,0" Click="OnExportAllClick" />
                <Button Content="Factory defaults" Padding="8,2" Margin="0,0,6,0" Click="OnFactoryDefaultsClick"
                        ToolTip="Back to the built-in schemes: deletes added schemes and every change" />
                <TextBlock x:Name="Status" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                           Text=".txt, .log and .lm files always use the highlight rules." />
            </StackPanel>
        </DockPanel>

        <!-- Scheme list -->
        <DockPanel DockPanel.Dock="Left" Width="200" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Add" Padding="8,2" Margin="0,0,6,0" Command="{Binding AddSchemeCommand}" />
                <Button Content="Duplicate" Padding="8,2" Margin="0,0,6,0" Command="{Binding DuplicateSchemeCommand}" />
                <Button Content="Delete" Padding="8,2" Command="{Binding DeleteSchemeCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Schemes}" SelectedItem="{Binding SelectedScheme}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding ExtensionsText}" FontSize="11" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Selected scheme -->
        <Grid DataContext="{Binding SelectedScheme}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="140" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" Text="{Binding Name}" VerticalContentAlignment="Center" />
                <TextBlock Grid.Column="2" Text="File types:" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="3" Text="{Binding ExtensionsText}" VerticalContentAlignment="Center"
                         ToolTip="Extensions such as .cs; .csx, or file names such as Dockerfile. .txt, .log and .lm are not allowed." />
            </Grid>

            <DataGrid x:Name="RulesGrid" Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                      SelectionMode="Single" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Token" Width="120" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Regex" Width="*" Binding="{Binding Pattern}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTip" Value="{Binding Pattern}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridCheckBoxColumn Header="Case" Binding="{Binding MatchCase, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="Light color" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><views:ColorField Color="{Binding LightColor, BindingGroupName=Direct}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Dark color" Width="100" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><views:ColorField Color="{Binding DarkColor, BindingGroupName=Direct}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Bold" Binding="{Binding Bold, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridCheckBoxColumn Header="Italic" Binding="{Binding Italic, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Problem" Width="120" IsReadOnly="True" Binding="{Binding Error}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                <Setter Property="ToolTip" Value="{Binding Error}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,6">
                <Button Content="Add rule" Padding="8,2" Margin="0,0,6,0" Command="{Binding AddRuleCommand}" />
                <Button Content="Remove" Padding="8,2" Margin="0,0,6,0" Command="{Binding RemoveRuleCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
                <Button Content="Move up" Padding="8,2" Margin="0,0,6,0" Command="{Binding MoveRuleUpCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
                <Button Content="Move down" Padding="8,2" Command="{Binding MoveRuleDownCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=RulesGrid}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                           Text="Each line is colored on its own. The earliest match wins; at the same place, the first rule wins." />
            </StackPanel>

            <!-- Sample: type lines on the left, see them colored on the right. -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SampleInput" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="OnSampleChanged" ToolTip="Sample text to color" />
                <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource PaneBorderBrush}"
                        Background="{DynamicResource ViewerBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock x:Name="SampleOutput" Padding="4,2" FontFamily="Cascadia Mono, Consolas"
                                   Foreground="{DynamicResource ViewerForegroundBrush}" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
