<!--
    The built-in assistant (ticket 05). DataContext is the AssistantViewModel. While it is off, the panel says
    what would be sent to Anthropic and asks for an API key; once on, it shows the conversation.
-->
<UserControl x:Class="Lignum.App.Views.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PaneBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ShownWhenOff" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close (Ctrl+Shift+A)" Padding="6,0"
                    Command="{Binding TogglePanelCommand}" />
            <Button DockPanel.Dock="Right" Content="New conversation" Padding="6,0" Margin="0,0,4,0"
                    Command="{Binding ClearCommand}" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Assistant" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Off: what turning it on means, the API key and the model. -->
        <ScrollViewer DockPanel.Dock="Top" Style="{StaticResource ShownWhenOff}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="The assistant uses Claude, by Anthropic, to help with your logs: find patterns, write regular expressions, explain errors, and add filters, highlights and bookmarks for you." />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"
                           Text="When it is on, what you type and the log lines it reads are sent to Anthropic's API and billed to your API key. Logs can contain sensitive data. Nothing is sent while it is off." />
                <TextBlock Text="Anthropic API key" Margin="0,4,0,2" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Save key" Padding="6,0" Margin="4,0,0,0" Click="OnSaveKeyClick" />
                    <PasswordBox x:Name="KeyBox" />
                </DockPanel>
                <TextBlock Margin="0,2,0,0" Opacity="0.7" TextWrapping="Wrap"
                           Text="Stored encrypted for your Windows user. Without one, ANTHROPIC_API_KEY is used." />
                <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource ErrorForegroundBrush}" Text="No API key yet."
                           Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Text="Model" Margin="0,8,0,2" />
                <TextBox Text="{Binding Model, UpdateSourceTrigger=LostFocus}" />
                <Button Content="Turn on the assistant" Padding="8,2" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Command="{Binding TurnOnCommand}" />
            </StackPanel>
        </ScrollViewer>

        <!-- On: the input at the bottom, the conversation above it. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Send" Padding="10,1" Command="{Binding SendCommand}" />
                <Button DockPanel.Dock="Right" Content="Stop" Padding="10,1" Margin="0,0,4,0" Command="{Binding StopCommand}" />
                <Button DockPanel.Dock="Left" Content="Turn off" Padding="6,1" Command="{Binding TurnOffCommand}"
                        ToolTip="Stop sending anything to Anthropic" />
                <TextBlock />
            </DockPanel>
            <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="48" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                     ToolTip="Enter sends; Shift+Enter starts a new line" PreviewKeyDown="OnInputKeyDown" />
        </DockPanel>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged"
                      Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock x:Name="Who" FontWeight="SemiBold" Visibility="Collapsed" />
                            <!-- A read-only text box, so answers can be selected and copied. -->
                            <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{DynamicResource WindowForegroundBrush}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="User">
                                <Setter TargetName="Who" Property="Text" Value="You" />
                                <Setter TargetName="Who" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Assistant">
                                <Setter TargetName="Who" Property="Text" Value="Claude" />
                                <Setter TargetName="Who" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Activity">
                                <Setter TargetName="Body" Property="Opacity" Value="0.65" />
                                <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
