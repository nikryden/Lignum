<!--
    AI access (ticket 05). DataContext is the AssistantViewModel. While off, the panel says what turning it on
    allows and how to connect an AI tool; once on, it lists every call AI tools make.
-->
<UserControl x:Class="Lignum.App.Views.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PaneBackgroundBrush}"
             Foreground="{DynamicResource WindowForegroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ShownWhenOff" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,6">
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close (Ctrl+Shift+A)" Padding="6,0"
                    Command="{Binding TogglePanelCommand}" />
            <Button DockPanel.Dock="Right" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,2" Margin="0,0,4,0"
                    ToolTip="Check the agent again" Command="{Binding RefreshAgentCommand}"
                    Visibility="{Binding ShowAgentIcons, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,2" Margin="0,0,4,0"
                    ToolTip="Sign in to the agent again" Command="{Binding SignInAgentCommand}"
                    Visibility="{Binding ShowAgentIcons, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Content="&#xE90E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,2" Margin="0,0,4,0"
                    ToolTip="Dock at the bottom" Command="{Binding Layout.DockBottomCommand}" />
            <Button DockPanel.Dock="Right" Content="&#xE90D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Padding="6,2" Margin="0,0,4,0"
                    ToolTip="Dock on the right" Command="{Binding Layout.DockRightCommand}" />
            <TextBlock Text="AI access" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- How to connect an AI tool: shown both when off and on. -->
        <Expander DockPanel.Dock="Bottom" Header="Connect an AI tool" Margin="8" IsExpanded="False">
            <StackPanel Margin="0,4,0,0">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Add Lignum as an MCP server in your AI tool once. Copy the setting for your tool and paste it where the tool keeps its MCP servers:" />
                <Button Content="Copy for VS Code / GitHub Copilot (mcp.json)" Margin="0,2" HorizontalContentAlignment="Left"
                        Padding="6,1" Tag="vscode" Click="OnCopySetupClick" />
                <Button Content="Copy for Claude Desktop, Cursor, Windsurf, Antigravity (mcpServers JSON)" Margin="0,2" HorizontalContentAlignment="Left"
                        Padding="6,1" Tag="claude-desktop" Click="OnCopySetupClick" />
                <Button Content="Copy OpenAI Codex command" Margin="0,2" HorizontalContentAlignment="Left"
                        Padding="6,1" Tag="codex" Click="OnCopySetupClick" />
                <Button Content="Copy Claude Code command" Margin="0,2" HorizontalContentAlignment="Left"
                        Padding="6,1" Tag="claude-code" Click="OnCopySetupClick" />
                <TextBlock x:Name="CopiedText" Margin="0,4,0,0" Opacity="0.7" />
                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" Text="{Binding ExePath, StringFormat=Lignum: {0}}" />
            </StackPanel>
        </Expander>

        <!-- On: the chat. The selected agent CLI runs on the user's own subscription with Lignum's tools. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,4,8,0" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="New conversation" Padding="6,0" Command="{Binding NewConversationCommand}" />
                <ComboBox ItemsSource="{Binding AgentNames}" SelectedIndex="{Binding SelectedAgent}" Margin="0,0,4,0"
                          ToolTip="The AI agent installed on this PC that answers here" />
            </DockPanel>
            <!-- Model and reasoning level (ticket 16): empty = the agent's own default. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <ComboBox DockPanel.Dock="Right" Width="90" Margin="4,0,0,0"
                          ItemsSource="{Binding EffortChoices}" SelectedItem="{Binding AgentEffort}"
                          ToolTip="Reasoning level (empty = the agent's default)"
                          Visibility="{Binding SupportsEffort, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Left" Text="Model" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8" />
                <ComboBox IsEditable="True" ItemsSource="{Binding ModelSuggestions}"
                          Text="{Binding AgentModel, UpdateSourceTrigger=LostFocus}"
                          ToolTip="Model name or alias (empty = the agent's default); used from the next question" />
            </DockPanel>
            <!-- Custom agent: its command and argument template. -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4" Visibility="{Binding IsCustomAgent, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Command (name on PATH, or full path)" Opacity="0.8" />
                <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,4" />
                <TextBlock Text="Arguments: {prompt} = the question, {mcpConfig} = MCP settings file with Lignum, {lignum} = Lignum.exe, {model} and {effort} = the model and reasoning choices above (dropped with their flag when empty)"
                           Opacity="0.8" TextWrapping="Wrap" />
                <TextBox Text="{Binding CustomArguments, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,0" />
            </StackPanel>
            <!-- Setup: a warning until the agent is installed and signed in; then the header icons take over. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,6" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource BannerBackgroundBrush}" BorderBrush="{DynamicResource BannerBorderBrush}"
                    Visibility="{Binding ShowAgentSetup, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BannerForegroundBrush}">
                        <Run Text="&#x26A0;" /> <Run Text="{Binding AgentStatus, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Install" Padding="8,0" Margin="0,0,4,0" Command="{Binding InstallAgentCommand}"
                                Visibility="{Binding IsAgentInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                                ToolTip="Runs the official installer in a PowerShell window you can see" />
                        <Button Content="Sign in" Padding="8,0" Margin="0,0,4,0" Command="{Binding SignInAgentCommand}"
                                Visibility="{Binding IsAgentInstalled, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Opens the agent in a terminal for its one-time sign-in" />
                        <Button Content="Check again" Padding="8,0" Command="{Binding RefreshAgentCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Token usage (ticket 20): last turn, conversation total and context window, when the agent reports them. -->
            <TextBlock DockPanel.Dock="Bottom" Margin="0,2,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                       Text="{Binding UsageText}" ToolTip="Tokens as reported by the agent; in = prompt including cached tokens" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Send" Padding="10,1" Command="{Binding SendCommand}" />
                <Button DockPanel.Dock="Right" Content="Stop" Padding="10,1" Margin="0,0,4,0" Command="{Binding StopCommand}" />
                <!-- Skills: saved instructions used with /name (global, or next to the selected log). -->
                <Button Content="Skills ▾" Padding="8,1" HorizontalAlignment="Left" Click="OnSkillsClick"
                        ToolTip="Open the skills folders; type / in the message to use a skill, or ask the AI to make one">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open _global skills folder" Command="{Binding OpenGlobalSkillsFolderCommand}"
                                      ToolTip="For every log: %APPDATA%\Lignum\skills" />
                            <MenuItem Header="Open _local skills folder" Command="{Binding OpenLocalSkillsFolderCommand}"
                                      ToolTip="Next to the selected log: .lignum\skills" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
            <Grid>
                <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="48" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         ToolTip="Ask about the open logs. Enter sends; Shift+Enter starts a new line; / lists your skills"
                         PreviewKeyDown="OnInputKeyDown" LostKeyboardFocus="OnInputLostFocus" />
                <!-- Skill suggestions while a "/name" is typed at the start of the message. -->
                <Popup IsOpen="{Binding IsSkillListOpen}" PlacementTarget="{Binding ElementName=InputBox}" Placement="Top"
                       StaysOpen="True" AllowsTransparency="True" Focusable="False"
                       Width="{Binding ActualWidth, ElementName=InputBox}">
                    <Border Background="{DynamicResource PaneBackgroundBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="2">
                        <ListBox x:Name="SkillList" ItemsSource="{Binding SkillSuggestions}" MaxHeight="220"
                                 SelectedItem="{Binding SelectedSkillSuggestion}" Focusable="False" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource WindowForegroundBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="OnSkillListClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,1">
                                        <TextBlock>
                                            <Run Text="/" FontWeight="SemiBold" /><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding ScopeText, Mode=OneWay}" Foreground="Gray" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.8" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </DockPanel>

        <!-- Off: what turning it on means. -->
        <StackPanel DockPanel.Dock="Top" Margin="8" Style="{StaticResource ShownWhenOff}">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Let AI tools you already use (GitHub Copilot, Claude, Cursor and others) work with your open logs: search them, read lines, and add filters, highlights and bookmarks for you. No API key is needed: the AI runs in your tool, on your own subscription." />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="SemiBold"
                       Text="When it is on, the lines an AI tool reads are sent to that tool's AI service. Logs can contain sensitive data. Nothing is shared while it is off." />
            <Button Content="Turn on AI access" Padding="8,2" HorizontalAlignment="Left" Command="{Binding TurnOnCommand}" />
        </StackPanel>

        <!-- On: what AI tools did. -->
        <DockPanel DockPanel.Dock="Top" Margin="8,0,8,4" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <Button DockPanel.Dock="Right" Content="Turn off" Padding="6,0" Command="{Binding TurnOffCommand}"
                    ToolTip="Stop AI tools from using Lignum" />
            <Button DockPanel.Dock="Right" Content="Clear" Padding="6,0" Margin="0,0,4,0" Command="{Binding ClearCommand}" />
            <TextBlock Text="On: ask here, or from your AI tool" VerticalAlignment="Center" Opacity="0.8" />
        </DockPanel>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged"
                      Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Entries}" Margin="8,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <TextBlock x:Name="Who" FontWeight="SemiBold" Visibility="Collapsed" />
                            <TextBox x:Name="Body" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="0"
                                     Foreground="{DynamicResource WindowForegroundBrush}" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="User">
                                <Setter TargetName="Who" Property="Text" Value="You" />
                                <Setter TargetName="Who" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Assistant">
                                <Setter TargetName="Who" Property="Text" Value="AI" />
                                <Setter TargetName="Who" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Activity">
                                <Setter TargetName="Body" Property="Opacity" Value="0.65" />
                                <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
