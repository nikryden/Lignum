<!-- The find box (Ctrl+F). DataContext is the SearchViewModel. -->
<UserControl x:Class="Lignum.App.Views.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lignum.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <Border Visibility="{Binding IsFindBarOpen, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource PaneBackgroundBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
            BorderThickness="0,0,0,1" Padding="8,4">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="✕" ToolTip="Close (Esc)" Padding="8,1" Margin="4,0,0,0"
                    Command="{Binding CloseFindBarCommand}" />
            <Button DockPanel.Dock="Right" Content="Next" ToolTip="Next match (F3)" Padding="8,1" Margin="4,0,0,0"
                    Command="{Binding FindNextCommand}" />
            <Button DockPanel.Dock="Right" Content="Previous" ToolTip="Previous match (Shift+F3)" Padding="8,1" Margin="4,0,0,0"
                    Command="{Binding FindPreviousCommand}" />
            <Button DockPanel.Dock="Right" Content="Find _all" ToolTip="List every matching line (Enter)" Padding="10,1" Margin="8,0,0,0"
                    Command="{Binding FindAllCommand}" />
            <ToggleButton DockPanel.Dock="Right" Content="NB" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="NonBacktracking regex engine: never hangs, but no backreferences or lookarounds (Alt+B)"
                          IsEnabled="{Binding IsRegex}" IsChecked="{Binding UseNonBacktracking}" />
            <ToggleButton DockPanel.Dock="Right" Content=".*" Padding="6,1" Margin="4,0,0,0"
                          ToolTip="Use regular expression (Alt+R)" IsChecked="{Binding IsRegex}" />
            <ToggleButton DockPanel.Dock="Right" Content="Aa" Padding="6,1" Margin="8,0,0,0"
                          ToolTip="Match case (Alt+C)" IsChecked="{Binding MatchCase}" />
            <TextBlock DockPanel.Dock="Left" Text="Find:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding FindTextError}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource ErrorForegroundBrush}"
                       Visibility="{Binding FindTextError, Converter={StaticResource NullToCollapsed}}" />
            <!-- Editable so the dropdown offers the last 20 searches (ticket 18); no autocomplete while typing. -->
            <ComboBox x:Name="FindBox" IsEditable="True" IsTextSearchEnabled="False" VerticalContentAlignment="Center"
                      Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding History.SearchTerms}"
                      ToolTip="{Binding FindTextError}">
                <ComboBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding FindAllCommand}" />
                    <KeyBinding Key="Escape" Command="{Binding CloseFindBarCommand}" />
                    <KeyBinding Key="C" Modifiers="Alt" Command="{Binding ToggleMatchCaseCommand}" />
                    <KeyBinding Key="R" Modifiers="Alt" Command="{Binding ToggleRegexCommand}" />
                    <KeyBinding Key="B" Modifiers="Alt" Command="{Binding ToggleNonBacktrackingCommand}" />
                </ComboBox.InputBindings>
            </ComboBox>
        </DockPanel>
    </Border>
</UserControl>
