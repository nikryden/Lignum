<!-- "File changed: Reload" strip. DataContext is the MainViewModel (inherited from the window). -->
<UserControl x:Class="Lignum.App.Views.FileChangedBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border Visibility="{Binding IsFileChanged, Converter={StaticResource BoolToVisibility}}"
            Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="0,0,0,1" Padding="8,4">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="_Reload" Padding="10,1"
                    Command="{Binding ReloadCommand}" />
            <TextBlock VerticalAlignment="Center" Foreground="#3A2E00">
                <Run Text="File changed:" FontWeight="SemiBold" />
                <Run Text="{Binding FileChangeMessage, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
