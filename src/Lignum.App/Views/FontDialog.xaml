<!-- View > Font…: pick the viewer's monospaced font and base size. -->
<Window x:Class="Lignum.App.Views.FontDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16" MinWidth="320">
        <TextBlock Text="Font (monospaced fonts)" Margin="0,0,0,4" />
        <ComboBox x:Name="FamilyBox" IsEditable="True" Margin="0,0,0,12" />
        <TextBlock Text="Size (points)" Margin="0,0,0,4" />
        <TextBox x:Name="SizeBox" Margin="0,0,0,12" />
        <Border BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1" Padding="8"
                Background="{DynamicResource ViewerBackgroundBrush}" Margin="0,0,0,16">
            <TextBlock x:Name="Preview" Text="2026-10-16 12:00:00 INFO Sample log line 0123456789"
                       Foreground="{DynamicResource ViewerForegroundBrush}"
                       FontFamily="{Binding Text, ElementName=FamilyBox}" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
