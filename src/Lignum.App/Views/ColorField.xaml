<!--
    A #RRGGBB color field: type the value, or pick it from the palette behind the swatch button.
    Color is two-way and updates when the text box loses focus or a color is picked (not on every keystroke).
-->
<UserControl x:Class="Lignum.App.Views.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel x:Name="Root">
        <Button x:Name="SwatchButton" DockPanel.Dock="Right" Width="22" Margin="2,0,0,0" Padding="2"
                ToolTip="Pick a color" Click="OnSwatchButtonClick">
            <Border BorderThickness="1" BorderBrush="{DynamicResource PaneBorderBrush}">
                <Rectangle x:Name="SwatchRect" Width="14" Height="12" />
            </Border>
        </Button>
        <TextBox x:Name="Box" VerticalContentAlignment="Center" LostFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" />
        <Popup x:Name="Palette" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="False" KeyDown="OnPaletteKeyDown">
            <Border Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="1"
                    BorderBrush="{DynamicResource PaneBorderBrush}" Padding="6">
                <StackPanel>
                    <ItemsControl x:Name="PaletteItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="20" Height="20" Margin="1" Padding="0" BorderThickness="1"
                                        Tag="{Binding}" ToolTip="{Binding}" Click="OnPaletteColorClick">
                                    <Button.Background>
                                        <SolidColorBrush Color="{Binding}" />
                                    </Button.Background>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="None" Margin="1,6,1,0" Padding="8,2" HorizontalAlignment="Left"
                            Click="OnNoneClick" />
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
