<!-- The detail pane (ticket 07). DataContext is the tab's DetailPaneViewModel. -->
<UserControl x:Class="Lignum.App.Views.DetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Lignum.App.Settings"
             Background="{DynamicResource PaneBackgroundBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- BasedOn keeps the app's Fluent button look, like the other panes' buttons. -->
        <Style x:Key="PaneButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- Icon buttons, as in the AI access pane. -->
        <Style x:Key="PaneIconButton" TargetType="Button" BasedOn="{StaticResource PaneButton}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="6,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- App-wide: a multi-line selection also shows the lines the main view hides between its ends. -->
                    <CheckBox Content="Hidden lines" VerticalAlignment="Center" Margin="4,0" Focusable="False"
                              ToolTip="When several lines are selected, also show the lines the filter hides between them"
                              IsChecked="{Binding DataContext.DetailPane.IncludeHiddenLines, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="&#xE8C8;" ToolTip="{Binding CopyLabel}" Click="OnCopyLineClick"
                            Style="{StaticResource PaneIconButton}" />
                    <!-- Layout commands are app-wide: the window's MainViewModel.DetailPane. -->
                    <Button Content="&#xE90E;" ToolTip="Dock at the bottom"
                            Command="{Binding DataContext.DetailPane.DockBottomCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.DetailPane.Dock, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static settings:DetailPaneDock.Bottom}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE90D;" ToolTip="Dock on the right"
                            Command="{Binding DataContext.DetailPane.DockRightCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PaneIconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.DetailPane.Dock, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Value="{x:Static settings:DetailPaneDock.Right}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" ToolTip="Collapse the detail pane (View menu reopens it)"
                            Command="{Binding DataContext.DetailPane.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Style="{StaticResource PaneButton}" />
                </StackPanel>
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Margin="6,0,6,4" TextWrapping="Wrap"
                       Text="{Binding Notice}" Foreground="{DynamicResource ErrorForegroundBrush}"
                       Visibility="{Binding IsCapped, Converter={StaticResource BoolToVisibility}}" />
            <TextBox x:Name="LineText" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                     IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Padding="4"
                     Background="{DynamicResource ViewerBackgroundBrush}"
                     Foreground="{DynamicResource ViewerForegroundBrush}"
                     FontFamily="{Binding Appearance.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                     FontSize="{Binding Appearance.EffectiveFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
        </DockPanel>
    </Border>
</UserControl>
