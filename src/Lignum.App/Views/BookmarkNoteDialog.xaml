<!-- "Edit description…" (ticket 06; "Edit bookmark note…" before ticket 23). An empty note removes the note but keeps the bookmark. -->
<Window x:Class="Lignum.App.Views.BookmarkNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bookmark description" SizeToContent="Height" Width="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">
    <StackPanel Margin="16">
        <TextBlock x:Name="Prompt" Margin="0,0,0,4" />
        <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="Leave empty to remove the description (the bookmark stays)." Opacity="0.7" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
